<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:id="@+id/tvDebtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_debt_loan"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/rgDebtType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbDebt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debt_type_owe"
            android:textSize="13sp"
            android:textColor="@color/debt"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbReceivable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debt_type_owed_to_me"
            android:textSize="13sp"
            android:textColor="@color/receivable" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/person_name"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etPersonName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/person_name_hint"
        android:textSize="14sp"
        android:inputType="textPersonName"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debt_amount"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDebtAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/debt_amount_hint"
        android:textSize="14sp"
        android:inputType="numberDecimal"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDebtAccountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debt_account_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerDebtAccount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debt_date_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDebtDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/debt_date_label"
        android:textSize="14sp"
        android:focusable="false"
        android:clickable="true"
        android:inputType="date"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/due_date_optional"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDebtDueDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/due_date_hint"
        android:textSize="14sp"
        android:focusable="false"
        android:clickable="true"
        android:inputType="date"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debt_reference_optional"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDebtReference"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/debt_reference_hint"
        android:textSize="14sp"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debt_note_optional"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDebtNote"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/debt_note_hint"
        android:textSize="14sp"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelDebt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_variant"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSaveDebt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:textColor="@color/black"
            android:backgroundTint="@color/primary" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
